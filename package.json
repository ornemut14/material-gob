{
  "name": "@kucho77/material-gob",
  "version": "0.5.1",
  "description": "Reusable React UI components",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "dist/material-gob.cjs.js",
  "module": "dist/material-gob.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/material-gob.es.js",
      "require": "./dist/material-gob.cjs.js"
    },
    "./styles.css": "./dist/material-gob.css"
  },
  "scripts": {
    "dev": "vite",
    "generate:icons": "node src/scripts/generate-icons.js",
    "build": "npm run generate:icons && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "dayjs": "^1.11.19",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
